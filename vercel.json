{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build:static",
  "outputDirectory": "frontend/dist",
  "rewrites": [{ "source": "/candidate/:sessionId", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
    ] },
    { "source": "/static/camera-worker.js", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; object-src 'none'" }
    ] },
    { "source": "/static/vision/wasm/:name.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
