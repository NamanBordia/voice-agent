# Server-side provider credentials. Never put keys in the browser or local config.
SARVAM_API_KEY=
CEREBRAS_API_KEY=

# Optional local server settings; use the documented localhost launch command.
HOST=127.0.0.1
PORT=8000

# Model, voice ID, greeting, prompts, and timing are edited at /config.
# On first startup data/runtime_config.json is created with canonical defaults.
